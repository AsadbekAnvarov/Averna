# Database
DATABASE_URL="postgresql://user:password@localhost:5432/averna_db?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here" # Generate with: openssl rand -base64 32

# OpenAI API (for AI Writing Checker & AI Mentor)
OPENAI_API_KEY="your-openai-api-key"

# Daily.co or Agora (for Speaking Time voice rooms)
DAILY_API_KEY="your-daily-api-key"
# OR
# AGORA_APP_ID="your-agora-app-id"
# AGORA_APP_CERTIFICATE="your-agora-certificate"

# Email (for notifications)
EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="noreply@averna.com"

# Pusher or Socket.io (for real-time features)
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_CLUSTER="your-cluster"

# ---------------------------------------------------------------------------
# Teaching tools (all optional — each feature switches itself off without them)
# ---------------------------------------------------------------------------

# Vercel Blob (PUBLIC store) — pre-rendered Listening audio + recorded Speaking answers.
# Created automatically when you connect a Blob store to the project in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=""

# OpenAI audio models (default gpt-4o-mini-tts for Listening voices, whisper-1 for Speaking transcripts)
# OPENAI_TTS_MODEL="gpt-4o-mini-tts"
# OPENAI_STT_MODEL="whisper-1"

# Kill switch: "off" serves every Listening part with browser voices instead of the
# pre-rendered recordings (e.g. while the Blob store is over its quota). Redeploy after changing.
# LISTENING_AUDIO="off"

# Days a recorded Speaking answer (audio file) is kept for the teacher (transcripts stay).
# Default 30; 0 = don't keep audio at all (only the transcript is saved).
# SPEAKING_AUDIO_RETENTION_DAYS="30"
# Speaking audio uploads per calendar month, re-takes included (Hobby Blob allows 2,000 uploads a
# month and the Listening renders need some). Past it answers are still transcribed and marked,
# only their audio isn't kept. Default 1500.
# SPEAKING_AUDIO_MONTHLY_UPLOADS="1500"
# Recorded answers (takes, re-takes included) per student per Tashkent day (≈ 8 full tests); then the
# test continues without recording. A single question accepts at most 5 takes per attempt.
# SPEAKING_DAILY_RECORDINGS="150"

# Telegram bot (create it with @BotFather: /newbot, then /setjoingroups → Disable so it stays
# out of group chats). Put the SAME three values in both Vercel projects (one bot, one database),
# redeploy, then press "Webhookni oʻrnatish" in Admin → Telegram on the production site. The
# webhook goes to NEXTAUTH_URL (else the Vercel production domain): that address must answer
# directly — Telegram doesn't follow redirects (e.g. averna.uz → www.averna.uz). Press the button
# again after a deploy that changes the bot's commands (it also refreshes the "/" menu).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""   # without @, e.g. AvernaSchoolBot
TELEGRAM_WEBHOOK_SECRET="" # 16–256 characters, only A–Z a–z 0–9 _ - (e.g. `openssl rand -hex 32`)

# Vercel Cron (vercel.json runs /api/cron/daily once a day, around 19:00 Tashkent). Without it the
# cron route refuses every call. Any random string, 16+ characters (e.g. `openssl rand -hex 32`).
CRON_SECRET=""

# Account mail (Resend): never put private values in Git. Configure in hosting settings.
# ACCOUNT_APP_URL must be the canonical public HTTPS origin, not a preview URL.
RESEND_API_KEY=""
ACCOUNT_MAIL_FROM="" # e.g. Averna <accounts@your-verified-domain>
ACCOUNT_APP_URL=""
# Enable only AFTER testing confirmation and recovery email delivery on staging.
# Existing accounts retain their current verification values; no mass sign-out.
REQUIRE_EMAIL_VERIFICATION="false"
# Shared ceiling across AI endpoints, measured in requests, NOT money or model calls.
# Set spending limits in the provider dashboard as well.
AI_DAILY_REQUEST_LIMIT="2000"

# Mobile-first learning reliability: staging only until the release checklist passes.
# One-task Writing PRACTICE drafts only, explicitly saved by the learner.
# Apply the reviewed writing_drafts migration to an isolated DB before enabling.
CLOUD_WRITING_DRAFTS="off"
# Authenticated external scheduler POSTs /api/cron/assessments (not automatically configured).
# Processes at most two SINGLE-TASK Writing retry jobs per call; not Speaking/mocks.
ASSESSMENT_SCHEDULER="off"
ASSESSMENT_SCHEDULER_SECRET="" # independent random secret, at least 32 characters

# Student-authored Adventures: teacher moderation + same-class approved library.
# Apply 20261010000100_adventure_workshops on isolated staging before enabling.
# Six personal tools work without this; no paid AI or automatic publishing.
ADVENTURE_WORKSHOP="off"
