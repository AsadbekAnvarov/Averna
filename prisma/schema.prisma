// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  PARENT
  ADMIN
}

enum HomeworkStatus {
  PENDING
  SUBMITTED
  GRADED
  LATE
}

enum IELTSModule {
  WRITING
  READING
  LISTENING
  SPEAKING
}

enum AchievementType {
  HOMEWORK_MASTER
  SPEAKING_CHAMPION
  READING_EXPERT
  WRITING_GURU
  LISTENING_MASTER
  TOP_PERFORMER
  STREAK_WARRIOR
  EARLY_BIRD
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  /// Unique sign-in name (lower case, see lib/account/username-rules); null until the user picks one.
  username          String?   @unique
  name              String?
  password          String
  role              UserRole  @default(STUDENT)
  image             String?
  emailVerified     DateTime?
  /// Last password change: sessions signed in before it end (lib/account/session-guard).
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  student          Student?
  teacher          Teacher?
  sessions         Session[]
  accountTokens    AccountToken[]
  accounts         Account[]
  notifications    Notification[]
  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  telegramLinks    TelegramLink[] @relation("TelegramUser")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Student {
  id               String    @id @default(cuid())
  userId           String    @unique
  groupId          String?
  personalGoal     String?
  level            String? // CEFR/IELTS level, set during enrollment
  phone            String?
  nativeLanguage   String?
  targetBand       String?
  bio              String?
  enrolledAt       DateTime?
  blacklisted      Boolean   @default(false)
  blacklistReason  String?
  totalPoints      Int       @default(0)
  globalRank       Int       @default(0)
  groupRank        Int       @default(0)
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  streakFreezes    Int       @default(1)
  balance          Int       @default(0)
  cosmetics        String[]  @default([])
  featuredCosmetic String?
  cosmeticBoxAt    DateTime?
  lastActiveDate   DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group               Group?                    @relation(fields: [groupId], references: [id])
  homeworkSubmissions HomeworkSubmission[]
  ieltsTests          IELTSTest[]
  achievements        StudentAchievement[]
  speakingSessions    SpeakingSession[]
  activityLogs        ActivityLog[]
  commitments         Commitment[]
  parentLinks         ParentStudentLink[]
  tutorBookings       TutorSlot[]
  attendances         Attendance[]
  grades              Grade[]
  redemptions         RewardRedemption[]
  payments            Payment[]
  mistakeEntries      MistakeEntry[]
  reviewItems         ReviewItem[]
  skillStates         SkillState[]
  learningEvents      LearningEvent[]
  learningProfile     LearningProfile?
  learningSnapshots   LearningProfileSnapshot[]
  xpTransactions      XpTransaction[]
  mockAttempts        MockAttempt[]
  speakingRecordings  SpeakingRecording[]
  placementAttempts   PlacementAttempt[]
  telegramParentLinks TelegramLink[]            @relation("TelegramParentChild")

  @@index([groupId])
  @@index([totalPoints])
  @@map("students")
}

model Teacher {
  id              String   @id @default(cuid())
  userId          String   @unique
  bio             String?
  specialty       String?
  ieltsBand       Float? // teacher's own IELTS overall band (0-9), shown to students
  isSecondTeacher Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups            Group[]
  homework          Homework[]
  homeworkGrades    HomeworkSubmission[]
  speakingSessions  SpeakingSession[]
  tutorSlots        TutorSlot[]
  attendanceRecords Attendance[]
  grades            Grade[]
  lessonLogs        LessonLog[]
  studentNotes      StudentNote[]
  homeworkTemplates HomeworkTemplate[]

  @@map("teachers")
}

model Group {
  id          String   @id @default(cuid())
  name        String
  teacherId   String
  description String?
  level       String?
  schedule    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  teacher       Teacher         @relation(fields: [teacherId], references: [id])
  students      Student[]
  rosterMembers RosterStudent[]
  homework      Homework[]
  attendances   Attendance[]
  lessonLogs    LessonLog[]

  @@index([teacherId])
  @@map("groups")
}

/// A student who belongs to a group but has NO site account.
///
/// The platform's `Student` model is inseparable from a `User` (login) — it
/// exists to power a personal dashboard. But a learning centre also enrols young
/// children who never touch the app, and the administrator still needs the full,
/// truthful roster of every group. This table is that roster: a group member the
/// admin manages by hand, holding only what a register needs (name, age, a parent
/// contact, a note). It is intentionally separate from `Student` so an account is
/// never fabricated for a child who shouldn't have one, and so the two lists can
/// be shown together without pretending a roster child can log in.
model RosterStudent {
  id         String   @id @default(cuid())
  groupId    String
  fullName   String
  parentName String?
  phone      String?
  age        Int?
  note       String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("roster_students")
}

model Homework {
  id           String      @id @default(cuid())
  title        String
  description  String      @db.Text
  teacherId    String
  groupId      String
  dueDate      DateTime
  points       Int         @default(10)
  difficulty   Int         @default(1)
  module       IELTSModule
  /// Exam homework from the test library (null = classic free-text homework):
  /// READING | LISTENING | WRITING_TASK1 | WRITING_TASK2 | WRITING_EXAM | SPEAKING
  contentKind  String?
  /// Catalog id of the paper / prompt / Speaking set.
  contentId    String?
  /// Reading passage / Listening part (0-based); null = the whole paper.
  contentPart  Int?
  contentTitle String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  teacher     Teacher              @relation(fields: [teacherId], references: [id])
  group       Group                @relation(fields: [groupId], references: [id])
  submissions HomeworkSubmission[]

  @@index([groupId])
  @@index([teacherId])
  @@index([dueDate])
  @@map("homework")
}

model HomeworkSubmission {
  id            String         @id @default(cuid())
  studentId     String
  homeworkId    String
  content       String         @db.Text
  status        HomeworkStatus @default(SUBMITTED)
  position      Int?
  pointsAwarded Int            @default(0)
  feedback      String?        @db.Text
  gradedBy      String?
  /// Exam homework: the IELTSTest that completed it (Writing exam: the Task 2 row).
  testId        String?
  /// Exam homework: band of that attempt (teacher review may update it).
  band          Float?
  submittedAt   DateTime       @default(now())
  gradedAt      DateTime?

  // Relations
  student  Student  @relation(fields: [studentId], references: [id])
  homework Homework @relation(fields: [homeworkId], references: [id])
  teacher  Teacher? @relation(fields: [gradedBy], references: [id])

  @@unique([studentId, homeworkId])
  @@index([homeworkId])
  @@index([status])
  @@index([testId])
  @@map("homework_submissions")
}

model IELTSTest {
  id          String      @id @default(cuid())
  studentId   String
  module      IELTSModule
  score       Float
  answers     Json
  aiAnalysis  Json?
  timeSpent   Int // in seconds
  completedAt DateTime    @default(now())

  // Relations
  student       Student          @relation(fields: [studentId], references: [id])
  review        TestReview?
  assessmentJob AiAssessmentJob?

  @@index([studentId])
  @@index([module])
  @@map("ielts_tests")
}

model Achievement {
  id          String          @id @default(cuid())
  type        AchievementType @unique
  name        String
  description String
  icon        String
  points      Int             @default(0)
  createdAt   DateTime        @default(now())

  // Relations
  students StudentAchievement[]

  @@map("achievements")
}

model StudentAchievement {
  id            String   @id @default(cuid())
  studentId     String
  achievementId String
  unlockedAt    DateTime @default(now())

  // Relations
  student     Student     @relation(fields: [studentId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([studentId, achievementId])
  @@index([studentId])
  @@map("student_achievements")
}

model SpeakingSession {
  id        String   @id @default(cuid())
  studentId String
  teacherId String?
  duration  Int // in minutes
  points    Int      @default(0)
  feedback  String?  @db.Text
  rating    Int? // 1-5 stars from teacher
  date      DateTime @default(now())

  // Relations
  student Student  @relation(fields: [studentId], references: [id])
  teacher Teacher? @relation(fields: [teacherId], references: [id])

  @@index([studentId])
  @@index([date])
  @@map("speaking_sessions")
}

// Streak Insurance — a student stakes points on a weekly study goal.
// Meet it → get the stake back plus a bonus; miss it → the stake is lost.
model Commitment {
  id         String   @id @default(cuid())
  studentId  String
  targetDays Int // number of study days required in the window
  stake      Int // points escrowed (deducted at creation)
  reward     Int // bonus points awarded on success
  startAt    DateTime
  endAt      DateTime
  status     String   @default("active") // active | succeeded | failed
  createdAt  DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("commitments")
}

model ActivityLog {
  id        String   @id @default(cuid())
  studentId String
  action    String
  details   Json?
  points    Int      @default(0)
  createdAt DateTime @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([createdAt])
  @@map("activity_logs")
}

model ParentStudentLink {
  id          String   @id @default(cuid())
  parentName  String
  parentEmail String
  studentId   String
  createdAt   DateTime @default(now())

  // Relations
  student Student @relation(fields: [studentId], references: [id])

  @@unique([parentEmail, studentId])
  @@index([studentId])
  @@map("parent_student_links")
}

model DailyQuote {
  id        String   @id @default(cuid())
  text      String   @db.Text
  author    String?
  date      DateTime @unique @default(now())
  createdAt DateTime @default(now())

  @@index([date])
  @@map("daily_quotes")
}

model TutorSlot {
  id        String   @id @default(cuid())
  teacherId String
  day       String // e.g. "Monday"
  startTime String // e.g. "18:00"
  endTime   String // e.g. "19:00"
  topic     String?
  studentId String?
  createdAt DateTime @default(now())

  // Relations
  teacher Teacher  @relation(fields: [teacherId], references: [id])
  student Student? @relation(fields: [studentId], references: [id])

  @@index([teacherId])
  @@index([studentId])
  @@map("tutor_slots")
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  groupId   String
  teacherId String?
  date      DateTime @default(now())
  status    String   @default("PRESENT") // PRESENT | ABSENT | LATE | EXCUSED
  note      String?
  createdAt DateTime @default(now())

  // Relations
  student Student  @relation(fields: [studentId], references: [id])
  group   Group    @relation(fields: [groupId], references: [id])
  teacher Teacher? @relation(fields: [teacherId], references: [id])

  @@index([groupId, date])
  @@index([studentId])
  @@map("attendance")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("system") // homework | grade | booking | message | system
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model Grade {
  id        String   @id @default(cuid())
  studentId String
  teacherId String?
  groupId   String?
  title     String
  score     Float
  maxScore  Float    @default(100)
  comment   String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  student Student  @relation(fields: [studentId], references: [id])
  teacher Teacher? @relation(fields: [teacherId], references: [id])

  @@index([studentId])
  @@map("grades")
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  reaction   String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@map("messages")
}

model Reward {
  id          String   @id @default(cuid())
  name        String
  description String?
  cost        Int
  icon        String?
  minLevel    Int      @default(1) // learner level required to redeem (gates premium gifts)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  redemptions RewardRedemption[]

  @@map("rewards")
}

model RewardRedemption {
  id        String   @id @default(cuid())
  studentId String
  rewardId  String
  cost      Int
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])
  reward  Reward  @relation(fields: [rewardId], references: [id])

  @@index([studentId])
  @@map("reward_redemptions")
}

model SpeakingQueue {
  id          String   @id @default(cuid())
  studentId   String   @unique
  studentName String
  roomId      String?
  topic       String?
  createdAt   DateTime @default(now())

  @@map("speaking_queue")
}

model SpeakingRoom {
  id           String    @id @default(cuid())
  topic        String
  studentAId   String
  studentAName String
  studentBId   String
  studentBName String
  status       String    @default("ACTIVE") // ACTIVE | ENDED
  createdAt    DateTime  @default(now())
  endedAt      DateTime?

  @@map("speaking_rooms")
}

model SpeakingMessage {
  id         String   @id @default(cuid())
  roomId     String
  senderId   String
  senderName String
  content    String
  createdAt  DateTime @default(now())

  @@index([roomId])
  @@map("speaking_messages")
}

model SpeakingSignal {
  id        String   @id @default(cuid())
  roomId    String
  senderId  String
  kind      String // offer | answer | ice
  payload   String   @db.Text
  createdAt DateTime @default(now())

  @@index([roomId])
  @@map("speaking_signals")
}

model LessonLog {
  id        String   @id @default(cuid())
  teacherId String
  groupId   String
  topic     String
  notes     String?  @db.Text
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id])
  group   Group   @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@map("lesson_logs")
}

model StudentNote {
  id        String   @id @default(cuid())
  teacherId String
  studentId String
  note      String   @db.Text
  createdAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@index([teacherId, studentId])
  @@map("student_notes")
}

model HomeworkTemplate {
  id          String   @id @default(cuid())
  teacherId   String
  title       String
  description String   @db.Text
  module      String
  points      Int      @default(50)
  createdAt   DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
  @@map("homework_templates")
}

model Announcement {
  id         String   @id @default(cuid())
  authorId   String
  authorName String
  scope      String   @default("ALL") // ALL | GROUP
  groupId    String?
  title      String
  body       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([scope])
  @@map("announcements")
}

model Payment {
  id          String   @id @default(cuid())
  studentId   String
  amount      Int
  type        String   @default("TOPUP") // TOPUP | COURSE | SUBSCRIPTION
  description String?
  status      String   @default("COMPLETED") // COMPLETED | PENDING
  createdAt   DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@map("payments")
}

/// Server-backed spaced-repetition ledger. One row per (student, item) — a
/// vocabulary word or a Mistake Bank entry — holding its SM-2 state so
/// retention syncs across devices and is visible to XP/streak/AI. The client
/// keeps localStorage for instant review UX and mirrors each review here.
model ReviewItem {
  id             String   @id @default(cuid())
  studentId      String
  itemKey        String
  source         String   @default("vocab") // vocab | mistake
  ease           Float    @default(2.5)
  interval       Int      @default(0) // days until next review
  reps           Int      @default(0)
  lapses         Int      @default(0)
  dueAt          DateTime @default(now())
  lastReviewedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, itemKey])
  @@index([studentId, dueAt])
  @@map("review_items")
}

/// Persisted mastery lifecycle per skill (locked → learning → practicing →
/// verified → mastered → retained). The stage itself is DERIVED from test
/// evidence (lib/student-intel getSkillStages); this table records it so we also
/// keep the transition history — which is what makes "you reached Verified"
/// celebrations, mastery velocity and cohort analytics possible.
model SkillState {
  id             String    @id @default(cuid())
  studentId      String
  skill          String // READING | LISTENING | WRITING | SPEAKING
  stage          String // locked | learning | practicing | verified | mastered | retained
  previousStage  String?
  evidenceCount  Int       @default(0)
  distinctDays   Int       @default(0)
  bestBand       Float     @default(0)
  recentAvg      Float     @default(0)
  retention      Int       @default(0) // 0-100
  stageChangedAt DateTime  @default(now())
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, skill])
  @@index([studentId])
  @@index([stage])
  @@map("skill_states")
}

model StudyMaterial {
  id          String   @id @default(cuid())
  title       String
  module      String // WRITING | READING | LISTENING | SPEAKING | VOCABULARY | GENERAL
  level       String // Beginner | Intermediate | Advanced | All
  description String?
  content     String?  @db.Text
  url         String?
  createdAt   DateTime @default(now())

  @@index([module])
  @@map("study_materials")
}

model DailyArticle {
  id         String   @id @default(cuid())
  title      String
  body       String   @db.Text
  vocabulary Json?
  date       DateTime @unique @default(now())
  createdAt  DateTime @default(now())

  @@map("daily_articles")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorName String
  role      String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}

/// Original, generated practice tests (Reading first; extensible to other modules).
/// The full test payload lives in `data` (same shape as lib/reading-tests-data.ts).
model GeneratedTest {
  id          String   @id @default(cuid())
  module      String   @default("READING")
  title       String
  description String   @default("")
  topic       String?
  level       String?
  published   Boolean  @default(false)
  data        Json
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([module, published])
}

// ============================================================================
// LEARNING DNA ENGINE (AVERNA-001)
// ============================================================================

/// The behavioural sensor stream that feeds the Learning DNA Engine.
///
/// Every model in Averna already stores *outcomes* (a band, a submission, a
/// streak). None of them store the *behaviour* that produced the outcome — which
/// channel the learner used, how long they stayed focused, what time of day it
/// was in their own timezone, which error categories appeared. Those are exactly
/// the signals a personalisation engine needs, so they get their own append-only
/// table rather than being reverse-engineered from unstructured JSON.
///
/// Design notes:
/// - APPEND-ONLY. Rows are never updated, so the stream is a truthful audit of
///   behaviour and can be re-processed with better maths at any time.
/// - PRE-BUCKETED TIME. `hourLocal`/`weekday`/`dayKey` are computed once, at
///   write time, in Asia/Tashkent — so "your best study hour" never depends on
///   the server's timezone and needs no per-request conversion of history.
/// - NORMALISED ACCURACY. `accuracy` is 0-1 for every kind of activity, which is
///   what makes cross-channel comparison ("you score higher by audio") valid.
/// - PRIVACY. Only measurements are stored, never learner content. `errorTags`
///   holds short category slugs (e.g. "articles", "time_pressure"), not answers.
model LearningEvent {
  id        String @id @default(cuid())
  studentId String

  /// test | review | homework | speaking | focus | ai_chat | checkin | game | lesson
  kind    String
  /// READING | LISTENING | WRITING | SPEAKING | GRAMMAR | VOCABULARY | null (mixed)
  skill   String?
  /// Delivery channel the learner actually used — the basis of learning-style
  /// detection: reading | audio | writing | speaking | flashcard | conversation | video | grammar
  channel String

  /// 0-1 normalised correctness. Null when the activity has no notion of correct.
  accuracy    Float?
  /// Time genuinely spent on the activity, in minutes.
  durationMin Float?
  /// Items attempted / answered correctly (questions, cards, prompts).
  items       Int?
  correct     Int?
  /// Words produced (writing) or consumed (reading) — powers writing complexity
  /// and reading speed.
  words       Int?
  /// Lexical diversity 0-1 of produced text, when applicable.
  diversity   Float?
  /// Self-reported confidence 0-1 (from a check-in), never inferred.
  confidence  Float?
  /// Difficulty of the material, when the content declares one.
  difficulty  String?
  /// Repeated mistake categories observed in this event.
  errorTags   String[] @default([])
  /// "sensor" (recorded live) or "derived" (back-filled from legacy outcome rows).
  origin      String   @default("sensor")

  /// Pre-bucketed Tashkent time so behavioural queries never re-convert history.
  hourLocal Int
  weekday   Int
  dayKey    String

  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([studentId, kind])
  @@index([studentId, dayKey])
  @@map("learning_events")
}

/// The living Learning DNA profile — one row per student, rewritten each time the
/// engine reconciles.
///
/// The scalar columns are deliberately denormalised out of `payload` so that
/// platform-wide admin aggregates ("average focus duration", "most common
/// learning style") are a single indexed scan instead of parsing thousands of
/// JSON blobs. `payload` carries the rich, evolving detail (per-skill breakdown,
/// style scores, insights, recommendations) whose shape changes as the engine
/// improves — versioned by `version` so a stale payload is recomputed rather
/// than mis-read.
model LearningProfile {
  id        String @id @default(cuid())
  studentId String @unique

  /// Engine schema version of `payload`. Bumped when the shape changes.
  version    Int      @default(1)
  computedAt DateTime @default(now())
  /// Number of behavioural events the profile was computed from — the honest
  /// measure of how much the engine actually knows about this learner.
  dataPoints Int      @default(0)
  /// 0-100: how developed this learner is as a *learner* (self-regulation,
  /// consistency, retention, breadth) — not how high their band is.
  maturity   Int      @default(0)
  /// insufficient | low | medium | high — overall trust in this profile.
  confidence String   @default("insufficient")

  // --- How they learn ---
  preferredStyle   String?
  styleConfidence  String  @default("insufficient")
  focusMinutes     Int?
  fatiguePointMin  Int?
  idealLessonMin   Int?
  optimalDaypart   String?
  optimalHourStart Int?
  optimalHourEnd   Int?

  // --- How well they learn ---
  confidenceScore    Int?
  retentionScore     Int?
  memoryHalfLifeDays Float?
  consistencyScore   Int?
  motivationScore    Int?
  motivationTrend    String?
  learningSpeed      Float?
  revisionEfficiency Int?
  skillBalance       Int?

  // --- What they know ---
  strongestSkill      String?
  weakestSkill        String?
  fastestGrowingSkill String?
  vocabularyGrowth    Int?
  grammarGrowth       Int?
  speakingConfidence  Int?
  writingComplexity   Int?
  readingSpeedWpm     Int?
  listeningAccuracy   Int?

  /// Full profile detail: per-skill metrics, style scores, insights (with their
  /// evidence), recommendations and the study plan.
  payload Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([preferredStyle])
  @@index([computedAt])
  @@map("learning_profiles")
}

/// One snapshot per student per day of the headline DNA metrics.
///
/// The live profile answers "who is this learner now"; only a time series can
/// answer "is motivation rising, is retention improving, is this learner
/// maturing" — which is the whole point of a profile that evolves. Kept to
/// scalars (cheap to store, cheap to chart) and unique per day so repeated
/// reconciliations during a day overwrite rather than accumulate.
model LearningProfileSnapshot {
  id        String @id @default(cuid())
  studentId String
  dayKey    String

  maturity         Int
  confidenceScore  Int?
  retentionScore   Int?
  consistencyScore Int?
  motivationScore  Int?
  learningSpeed    Float?
  focusMinutes     Int?
  dataPoints       Int     @default(0)
  preferredStyle   String?

  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, dayKey])
  /// Platform-wide trend queries scan by day across all students…
  @@index([dayKey])
  /// …and a single learner's history is read by day within their own rows.
  @@index([studentId, dayKey])
  @@map("learning_profile_snapshots")
}

// ============================================================================
// PROGRESSION ENGINE — XP LEDGER
// ============================================================================

/// Append-only ledger of every XP movement, with a per-student idempotency key.
///
/// The unique (studentId, idempotencyKey) pair is what makes XP reliable: a
/// double click, a page refresh, a network retry or a duplicate submission all
/// reuse the same key, so the database itself refuses the second award. The
/// ledger row is written in the SAME transaction as the totalPoints increment
/// (and, for tests, the IELTSTest row), so XP can never be paid without the
/// activity existing — or twice for one activity.
///
/// `breakdown` stores the engine's explanation ("30 questions +90 · accuracy
/// ×0.89 · first attempt +8 …") so the student can always see why they earned
/// what they earned. Badge / mission / challenge rewards use deterministic keys
/// (e.g. "badge:read-80", "mission:2026-09-27"), which doubles as their unlock
/// record.
model XpTransaction {
  id             String   @id @default(cuid())
  studentId      String
  idempotencyKey String
  /// XpSource from lib/engine/xp-engine (test | homework | achievement | …)
  source         String
  amount         Int
  /// READING | LISTENING | WRITING | SPEAKING | MISSION | CHALLENGE | BADGE | …
  activity       String?
  /// Id of the row this XP belongs to (e.g. the IELTSTest id).
  refId          String?
  breakdown      Json?
  createdAt      DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, idempotencyKey])
  @@index([studentId, createdAt])
  @@index([refId])
  @@map("xp_transactions")
}

/// One sitting of the full IELTS mock exam (Listening → Reading → Writing →
/// Speaking). Papers are picked at random from the full-format library when the
/// attempt starts; each section is graded and saved as an IELTSTest the moment
/// it is submitted, and the section clock lives here so a refresh can't reset it.
model MockAttempt {
  id               String    @id @default(cuid())
  studentId        String
  /// active | finished | abandoned
  status           String    @default("active")
  /// { listening, reading, task1, task2, speaking } — ids of the chosen papers.
  papers           Json
  /// Index of the current section (0 Listening … 3 Speaking; 4 = done).
  current          Int       @default(0)
  sectionStartedAt DateTime?
  sectionDeadline  DateTime?
  /// Autosaved answers of the running section.
  draft            Json?
  /// Per-section results keyed LISTENING | READING | WRITING | SPEAKING.
  results          Json      @default("{}")
  overall          Float?
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  updatedAt        DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@map("mock_attempts")
}

/// Pre-rendered Listening audio — one MP3 per part (all voices, pauses and exam
/// announcements baked in), stored in Vercel Blob. When a part has ready audio
/// that matches its current script, students hear the file instead of browser
/// text-to-speech and the script is no longer sent to the browser.
model ListeningAudio {
  id         String   @id @default(cuid())
  /// Exam id (seed id or GeneratedTest id).
  testId     String
  partIndex  Int
  /// ready | failed
  status     String   @default("ready")
  url        String?
  bytes      Int      @default(0)
  durationMs Int      @default(0)
  /// Hash of the part's script + voice settings: audio is stale once the script changes.
  scriptHash String
  voiceModel String
  /// [{ i: lineIndex (-1 = announcement), startMs, endMs }] — where each script line sits in the file.
  timeline   Json?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([testId, partIndex])
  @@map("listening_audio")
}

/// One recorded Speaking answer, transcribed on the server (Whisper). The audio
/// file is kept in Vercel Blob for the teacher until `expiresAt`.
model SpeakingRecording {
  id            String    @id @default(cuid())
  studentId     String
  /// The runner's attempt id (practice attempt id, or "<mockAttemptId>-S").
  attemptKey    String
  setId         String
  part          Int
  /// Position of the question in the set's flattened question list (Part 1 → Part 2 cue → follow-up → Part 3).
  questionIndex Int
  question      String
  transcript    String    @db.Text
  words         Int       @default(0)
  durationMs    Int       @default(0)
  audioUrl      String?
  audioBytes    Int       @default(0)
  mimeType      String?
  /// Speech metrics from the word timestamps (speech rate, long pauses …).
  metrics       Json?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, attemptKey, questionIndex])
  @@index([studentId, createdAt])
  @@index([expiresAt])
  @@map("speaking_recordings")
}

/// A teacher's review of a Writing / Speaking attempt. The reviewed band becomes
/// the attempt's band (IELTSTest.score); the AI's band is kept here.
model TestReview {
  id         String   @id @default(cuid())
  testId     String   @unique
  studentId  String
  /// User id of the teacher / admin who reviewed.
  reviewerId String
  aiBand     Float?
  band       Float
  /// Writing: { taskAchievement, coherenceCohesion, lexicalResource, grammarAccuracy }
  /// Speaking: { fluency, lexical, grammar, pronunciation }
  criteria   Json?
  comment    String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  test IELTSTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([reviewerId, createdAt])
  @@map("test_reviews")
}

/// Entry (placement) test sittings.
model PlacementAttempt {
  id             String    @id @default(cuid())
  studentId      String
  /// active | finished | abandoned
  status         String    @default("active")
  /// Sections in order and the content chosen for each.
  plan           Json
  current        Int       @default(0)
  draft          Json?
  results        Json      @default("{}")
  cefr           String?
  band           Float?
  recommendation String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  updatedAt      DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([finishedAt])
  @@map("placement_attempts")
}

/// A Telegram chat linked to an Averna user (student / teacher / admin) or,
/// for parents, to a child (parents don't need a website account).
model TelegramLink {
  id        String   @id @default(cuid())
  /// Telegram chat id (text: it can exceed 32-bit integers).
  chatId    String
  /// student | teacher | admin | parent
  role      String
  userId    String?  @unique
  /// Parent links: the child.
  studentId String?
  /// uz | ru | en
  language  String   @default("uz")
  username  String?
  firstName String?
  active    Boolean  @default(true)
  /// Notification preferences, e.g. { homework: true, reminders: true, reports: true }.
  prefs     Json?
  linkedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?    @relation("TelegramUser", fields: [userId], references: [id], onDelete: Cascade)
  student Student? @relation("TelegramParentChild", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([chatId, studentId])
  @@index([chatId])
  @@index([studentId])
  @@map("telegram_links")
}

/// One-time deep-link codes: t.me/<bot>?start=<code>.
model TelegramLinkCode {
  code        String    @id
  /// user | parent
  kind        String
  userId      String?
  studentId   String?
  createdById String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([studentId])
  @@map("telegram_link_codes")
}

/// Cached dictionary lookups (one per headword + target language).
model DictionaryEntry {
  id        String   @id @default(cuid())
  /// Normalised headword (lower case).
  word      String
  /// uz | ru
  lang      String
  data      Json
  /// ai | free
  source    String
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([word, lang])
  @@map("dictionary_entries")
}

/// Once-per-day guard for scheduled jobs (both Vercel projects share the database).
model CronRun {
  id        String   @id @default(cuid())
  job       String
  /// Tashkent calendar day, YYYY-MM-DD.
  day       String
  status    String   @default("running")
  details   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([job, day])
  @@map("cron_runs")
}

/// Student-owned corrections. The SRS ledger stores timing, not this content.
model MistakeEntry {
  id              String    @id
  studentId       String
  wrong           String    @db.Text
  right           String    @db.Text
  note            String?   @db.Text
  sourceTestId    String?
  practiceCount   Int       @default(0)
  lastPracticedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("mistake_entries")
}

/// Only hashes of emailed, one-use tokens are retained.
model AccountToken {
  tokenHash String   @id
  userId    String
  purpose   String
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("account_tokens")
}

/// Shared, atomic fixed-window counters. No raw email addresses or IPs.
model RateLimitBucket {
  id        String   @id
  hits      Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

// Durable retry of a single Writing practice fallback. Payload lives on IELTSTest.
model AiAssessmentJob {
  id            String    @id @default(cuid())
  testId        String    @unique
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  leaseToken    String?
  leaseUntil    DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  test          IELTSTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("ai_assessment_jobs")
}
